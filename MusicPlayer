public class MusicPlayer {
    public static void main(String[] args) throws Exception {
        String [] songTitles = {"Night Drive", "Slow Tide", "Copper Sky", "Static Bloom", "Low Orbit", "Glass Rivers"};
        String [] artists = {"Wilee", "IDID", "Ionara", "Nekta", "Jobii", "Willow Mae"};
        Playlist myPlaylist = new Playlist ();
        Library myLibrary = new Library ();
        System.out.println("--- 1. Build the playlist ---");
        for (int i = 0; i < songTitles.length; i++) {
            System.out.println(myPlaylist.addSong("s" + (i+1), songTitles [i], artists [i]));
            myLibrary.add("s" + (i+1), songTitles [i], artists [i]);
        }
        if (myPlaylist.addSong("s3", "Copper Sky", "Ionara")) {
            System.out.println("Song added successfully.");
        }
        else {
            System.out.println("duplicate s3: false");
        }
        System.out.println("playlist: [" + myPlaylist.showPlaylist() + "]");
        System.out.println("--- 2. Look up songs ---");
        System.out.println("find s4: " + myPlaylist.findSong("s4"));
        System.out.println("find s9: " + myPlaylist.findSong("s9"));
        System.out.println("--- 3. Play and move forward ---");
        System.out.println("play s1: " + myPlaylist.play("s1"));
        System.out.println("play s9: " + myPlaylist.play("s9"));
        System.out.println("next: " + myPlaylist.next());
        System.out.println("next: " + myPlaylist.next());
        System.out.println("history: [" + myPlaylist.history.showHistory() + "]");
        System.out.println("--- 4. Up next ---");
        System.out.println(myPlaylist.queueLater("s1"));
        System.out.println(myPlaylist.queueLater("s5"));
        System.out.println(myPlaylist.queueLater("s6"));
        System.out.println("queue s9: " + myPlaylist.queueLater("s9"));
        System.out.println("up next: [" + myPlaylist.showUpNext() + "]");
        System.out.println("next: " + myPlaylist.next());
        System.out.println("now playing: " + myPlaylist.nowPlaying());
        System.out.println("history: [" + myPlaylist.history.showHistory() + "]");
        System.out.println("--- 5. Back button ---");
        System.out.println("back: " + myPlaylist.back());
        System.out.println("up next: [" + myPlaylist.showUpNext() + "]");
        System.out.println("history: [" + myPlaylist.history.showHistory() + "]");
        System.out.println("--- 6. Remove songs ---");
        System.out.println("remove s5: " + myPlaylist.removeSong("s5"));
        System.out.println("remove current (s3): " + myPlaylist.removeSong("s3"));
        System.out.println("remove s9: " + myPlaylist.removeSong("s9"));
        System.out.println("playlist: [" + myPlaylist.showPlaylist() + "]");
        System.out.println("up next: [" + myPlaylist.showUpNext() + "]");
        System.out.println("--- 7. Remove songs are skipped ---");
        System.out.println("next: " + myPlaylist.next());
        System.out.println("next: " + myPlaylist.next());
        System.out.println("next at end: " + myPlaylist.next());
        System.out.println("now playing: " + myPlaylist.nowPlaying());
        System.out.println("back: " + myPlaylist.back());
        System.out.println("up next: [" + myPlaylist.showUpNext() + "]");
        System.out.println("--- 8. Play counts ---");
        System.out.println("s1: " + myPlaylist.playCount("s1"));
        System.out.println("s3: " + myPlaylist.playCount("s3"));
        System.out.println("s6: " + myPlaylist.playCount("s6"));
        System.out.println("s5 (removed): " + myPlaylist.playCount("s5"));
        System.out.println("--- 9. Empty player ---");
        myPlaylist.clearPlaylist();
        System.out.println("next: " + myPlaylist.next());
        System.out.println("back: " + myPlaylist.back());
        System.out.println("now playing: " + myPlaylist.nowPlaying());
        System.out.println("playlist: [" + myPlaylist.showPlaylist() + "]");
    }
}
